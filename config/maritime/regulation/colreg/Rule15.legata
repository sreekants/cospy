# COLREG.Rule15 :
# Status        : IMPLEMENTED (COS.022) - fed by Rule15.py, judged at the closest point of approach

define: {
    OS: OwnShip
}


# Crossing Situation
# When two power-driven vessels are crossing so as to involve risk of collision, the vessel which has the
# other on her own starboard side shall keep out of the way and shall, if the circumstances of the case
# admit, avoid crossing ahead of the other vessel.
#
# Judged by its outcome. Rule15.py queues a pair once it has passed its closest approach, marked
# GiveWay if own ship had the other on her starboard side with a risk of collision when the crossing
# began. Own ship must then have passed at least the minimum passing distance clear, and astern of
# the other vessel: at the closest approach she is abaft the other's beam.
clause['COLREG.Rule15/KeepClear']:{
    :{
        condition: {
            : (OS, TS).EncounterSituation is 'GiveWay'
            }
        assure:{
            : (OS, TS).Distance >= Vessel.Collision.PassingDistance
        }
    }
}

clause['COLREG.Rule15/CrossAstern']:{
    :{
        condition: {
            : (OS, TS).EncounterSituation is 'GiveWay'
            }
        assure:{
            : (OS, TS).AheadOfTarget is false
        }
    }
}
