# COLREG.Rule12 :
# Status        : IMPLEMENTED (COS.022) - (a); fed by Rule12.py with every encounter at risk but overtaking

define: {
    OS: OwnShip,
    TS: TargetShip
}

# Sailing Vessels

# (a) When two sailing vessels are approaching one another, so as to involve risk of collision, one of
# them shall keep out of the way of the other as follows;
clause['COLREG.Rule12.a']:{
    : {
        condition: {
            : (OS.Type is Vessel.Type.Sailing) and (TS.Type is Vessel.Type.Sailing) and
              ((OS, TS).Tack is 'Unknown')
         }
        exclude: {
            : OS.Status in [Vessel.Status.NotUnderCommand, Vessel.Status.RESTRICTED]
            : TS.Status in [Vessel.Status.NotUnderCommand, Vessel.Status.RESTRICTED]
            : OS.Operation is Vessel.Operation.Fishing
            : TS.Operation is Vessel.Operation.Fishing
            : OS.Status in [Vessel.Status.ANCHORED, Vessel.Status.MOORED, Vessel.Status.FASTENED, Vessel.Status.AGROUND]
         }
        assure: {
            : (OS, TS).Distance >= Vessel.Collision.PassingDistance
        }
    }
}

# (i) when each has the wind on a different side, the vessel which has the wind on the port
# side shall keep out of the way of the other;
clause['COLREG.Rule12.a.i']:{
    : {
        condition: {
            : (OS.Type is Vessel.Type.Sailing) and (TS.Type is Vessel.Type.Sailing) and
              ((OS, TS).Tack is 'Port') and ((OS, TS).TargetTack is 'Starboard')
         }
        exclude: {
            : OS.Status in [Vessel.Status.NotUnderCommand, Vessel.Status.RESTRICTED]
            : TS.Status in [Vessel.Status.NotUnderCommand, Vessel.Status.RESTRICTED]
            : OS.Operation is Vessel.Operation.Fishing
            : TS.Operation is Vessel.Operation.Fishing
            : OS.Status in [Vessel.Status.ANCHORED, Vessel.Status.MOORED, Vessel.Status.FASTENED, Vessel.Status.AGROUND]
         }
        assure: {
            : (OS, TS).Distance >= Vessel.Collision.PassingDistance
        }
    }
}

# (ii) when both have the wind on the same side, the vessel which is to windward shall keep
# out of the way of the vessel which is to leeward;
clause['COLREG.Rule12.a.ii']:{
    : {
        condition: {
            : (OS.Type is Vessel.Type.Sailing) and (TS.Type is Vessel.Type.Sailing) and
              ((((OS, TS).Tack is 'Port') and ((OS, TS).TargetTack is 'Port')) or
               (((OS, TS).Tack is 'Starboard') and ((OS, TS).TargetTack is 'Starboard'))) and
              ((OS, TS).Windward is true)
         }
        exclude: {
            : OS.Status in [Vessel.Status.NotUnderCommand, Vessel.Status.RESTRICTED]
            : TS.Status in [Vessel.Status.NotUnderCommand, Vessel.Status.RESTRICTED]
            : OS.Operation is Vessel.Operation.Fishing
            : TS.Operation is Vessel.Operation.Fishing
            : OS.Status in [Vessel.Status.ANCHORED, Vessel.Status.MOORED, Vessel.Status.FASTENED, Vessel.Status.AGROUND]
         }
        assure: {
            : (OS, TS).Distance >= Vessel.Collision.PassingDistance
        }
    }
}

# (iii) if a vessel with the wind on the port side sees a vessel to windward and cannot
# determine with certainty whether the other vessel has the wind on the port or on the
# starboard side, she shall keep out of the way of the other.
clause['COLREG.Rule12.a.iii']:{
    : {
        condition: {
            : (OS.Type is Vessel.Type.Sailing) and (TS.Type is Vessel.Type.Sailing) and
              ((OS, TS).Tack is 'Port') and ((OS, TS).TargetTack is 'Unknown') and
              ((OS, TS).Windward is false)
         }
        exclude: {
            : OS.Status in [Vessel.Status.NotUnderCommand, Vessel.Status.RESTRICTED]
            : TS.Status in [Vessel.Status.NotUnderCommand, Vessel.Status.RESTRICTED]
            : OS.Operation is Vessel.Operation.Fishing
            : TS.Operation is Vessel.Operation.Fishing
            : OS.Status in [Vessel.Status.ANCHORED, Vessel.Status.MOORED, Vessel.Status.FASTENED, Vessel.Status.AGROUND]
         }
        assure: {
            : (OS, TS).Distance >= Vessel.Collision.PassingDistance
        }
    }
}


# (b) For the purposes of this Rule the windward side shall be deemed to be the side opposite to that
# on which the mainsail is carried or, in the case of a square-rigged vessel, the side opposite to that on
# which the largest fore-and-aft sail is carried.
